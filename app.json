{
  "expo": {
    "name": "Sip",
    "slug": "sip",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sip.tracker",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Sip to scan drink barcodes and photograph drinks or labels. Drink photos are sent for recognition only when you request an estimate.",
        "NSMicrophoneUsageDescription": "Allow Sip to hear drink descriptions for voice logging.",
        "NSSpeechRecognitionUsageDescription": "Allow Sip to turn spoken drink descriptions into text using your device speech service."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sip.tracker",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.WRITE_HYDRATION",
        "android.permission.health.WRITE_NUTRITION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sip to scan drink barcodes and photograph drinks or labels. Drink photos are sent for recognition only when you request an estimate.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "./plugins/with-purchase-launch-mode",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Sip to hear your drink description.",
          "speechRecognitionPermission": "Allow Sip to transcribe your drink description using your device speech service."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Allow Sip to import your hydration records.",
          "NSHealthUpdateUsageDescription": "Allow Sip to save logged fluid intake and known drink nutrients.",
          "background": false
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-rationale",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@sentry/react-native"
    ],
    "scheme": "sip",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d9c71f60-65bc-447c-93f7-496709a410a1"
      }
    },
    "owner": "nagamadhun7"
  }
}
