{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sip-drink-maker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "durable_objects": {
    "bindings": [{ "name": "MAKER_USERS", "class_name": "MakerUser" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MakerUser"] }],
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "FREE_MONTHLY_USES": "3",
    "FREE_DAILY_LIMIT": "3",
    "PRO_DAILY_LIMIT": "10",
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": "",
  },
  "observability": { "enabled": false },
}
